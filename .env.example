# =============================================================================
# NOVA AI WEB APP - ENVIRONMENT VARIABLES
# =============================================================================
# IMPORTANT: Never commit .env.local to git. All secret keys must stay private.
# Only NEXT_PUBLIC_* variables are safe to expose to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Auth, Database, Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -----------------------------------------------------------------------------
# Stripe (Payments & Subscriptions)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Subscription plan price IDs
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SCALE=price_...

# Done-for-you package price IDs
STRIPE_PRICE_LANDING=price_...
STRIPE_PRICE_MVP=price_...
STRIPE_PRICE_MOBILE=price_...
STRIPE_PRICE_FULL_PRODUCT=price_...

# -----------------------------------------------------------------------------
# NOVA AI Proxy (Chat backend)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_NOVA_API_URL=https://api.vandy.ro

# -----------------------------------------------------------------------------
# Email Integration (SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
NOVA_REPORTS_EMAIL=founders@your-domain.com
NOVA_REPORTS_FROM_EMAIL="NOVA Reports <no-reply@your-domain.com>"

# -----------------------------------------------------------------------------
# Public Configuration (SAFE to expose to browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CALENDAR_LINK=https://calendar.google.com/

# OAuth providers (set to "true" to enable buttons)
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=true
